; Engine configuration file.
; Demo jugable del sistema de balanceo (ver docs/DISENO_SISTEMA_BALANCEO.md).

config_version=5

[application]

config/name="Web Swing Demo"
config/description="Demo jugable del sistema de balanceo con péndulo regulado."
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
